' Test: Random file I/O with PUT/GET
10 OPEN "RNDTEST.DAT" FOR RANDOM AS #1 LEN = 32
20 FIELD #1, 4 AS ID$, 28 AS NAME$
30 FOR I = 1 TO 5
40 LSET ID$ = MKI$(I)
50 LSET NAME$ = "Record " + STR$(I)
60 PUT #1, I
70 NEXT I
80 FOR I = 5 TO 1 STEP -1
90 GET #1, I
100 PRINT CVI(ID$); NAME$
110 NEXT I
120 CLOSE #1
130 KILL "RNDTEST.DAT"
140 END